# ChartsMaze session cookie (optional — needed for authenticated screener features)
# Get from: devtools → Application → Cookies → chartsmaze.com → "session"
CHARTSMAZE_SESSION=

# TradingView session ID — required for watchlist management
# Get from: devtools → Application → Cookies → tradingview.com → "sessionid"
TRADINGVIEW_SESSION=

# TradingView session signature (optional but recommended to avoid re-auth)
# Same location as above → "sessionid_sign"
TRADINGVIEW_SESSION_SIGN=
